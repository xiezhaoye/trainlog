{
  "name": "trainlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8788",
    "dev:remote": "wrangler dev --port 8788",
    "db:migrate": "wrangler d1 migrations apply trainlog-db --local",
    "db:seed": "wrangler d1 execute trainlog-db --local --file=scripts/seed-local.sql",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.35.0"
  }
}
