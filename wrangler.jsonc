{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainlog",
  "account_id": "b150998ae9545a98adb8c03d65019504",
  "workers_dev": true,
  "routes": [
    { "pattern": "trainlog.life", "custom_domain": true }
  ],
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEddDHA8Jc_PCfwC"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/login", "/login.html", "/signup", "/signup.html", "/app", "/app.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trainlog-db",
      "database_id": "0e121762-adb7-4879-967a-896b45ffb368",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "07d4d31ebca34f0fb41d8fe647d3aaaf"
    }
  ]
}
