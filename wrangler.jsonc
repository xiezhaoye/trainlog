{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainlog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/login", "/login.html", "/signup", "/signup.html", "/app", "/app.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trainlog-db",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ]
}
